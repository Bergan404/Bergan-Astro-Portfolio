---
import ProjectCards from "./cards/ProjectCards.astro";
import { projects } from "../constants/index.js";
---

<section class="relative py-24 sm:py-32" id="work">
  <span class="hash-span"></span>
  <div class="max-w-7xl mx-auto px-6 sm:px-10">
    <div class="reveal max-w-3xl">
      <p class="text-accent uppercase tracking-[0.25em] text-sm font-medium">My work</p>
      <h2 class="font-display font-bold text-white text-[34px] sm:text-[52px] mt-2">Projects.</h2>
      <p class="mt-5 text-secondary text-[17px] leading-[30px]">
        A selection of projects that showcase my experience through real-world
        work — each with links to the source. They reflect how I solve problems,
        work across technologies, and ship things end to end.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7 reveal">
      {projects.map((project) => (
        <ProjectCards
          title={project.name}
          image={project.image}
          link={project.source_code_link}
          description={project.description}
          tags={project.tags}
        />
      ))}
    </div>
  </div>
</section>
