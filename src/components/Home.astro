---
import { github } from "../../public/assets/index.js";
import { bergan } from "../../public/assets/index.js";
---

<section class="relative w-full min-h-screen flex items-center" id="hero">
  <div class="max-w-7xl mx-auto w-full px-6 sm:px-10 pt-28">
    <div class="max-w-2xl reveal">
      <!-- <p class="inline-flex items-center gap-2 glass rounded-full px-4 py-1.5 text-sm text-secondary mb-6">
        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
        Available for new projects
      </p> -->
      <img src={bergan.src} alt="Bergan Oudshoorn" class="w-40 h-40 rounded-full mb-6 object-cover gradient-border" />

      <h1 class="font-display font-bold text-white leading-[1.05] text-[44px] xs:text-[56px] sm:text-[72px] lg:text-[84px]">
        Hi, I'm <span class="text-gradient">Bergan</span>
      </h1>

      <p class="mt-6 text-secondary text-lg sm:text-xl leading-relaxed max-w-xl">
        A Software Developer crafting fast, polished
        <span class="text-white">user interfaces</span> and
        <span class="text-white">web applications</span>.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="#work" class="btn btn-primary">View my work</a>
        <a href="#contact" class="btn btn-ghost">Get in touch</a>
        <a
          href="https://github.com/Bergan404"
          target="_blank"
          rel="noopener"
          class="ml-1 w-11 h-11 rounded-full glass flex items-center justify-center hover:border-accent transition-colors"
          aria-label="GitHub"
        >
          <img src={github.src} alt="GitHub" class="w-5 h-5 object-contain" />
        </a>
      </div>
    </div>
  </div>
</section>
