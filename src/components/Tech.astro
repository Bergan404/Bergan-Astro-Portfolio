---
import { technologies } from "../constants/index.js";
---

<section class="relative py-24 sm:py-32" id="tech">
  <span class="hash-span"></span>
  <div class="max-w-6xl mx-auto px-6 sm:px-10">
    <div class="reveal max-w-3xl">
      <p class="text-accent uppercase tracking-[0.25em] text-sm font-medium">What I use</p>
      <h2 class="font-display font-bold text-white text-[34px] sm:text-[52px] mt-2">Tech stack.</h2>
      <p class="mt-5 text-secondary text-[17px] leading-[30px]">
        The languages, frameworks, and tools I reach for when building.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-2 xs:grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-4 reveal">
      {technologies.map((tech) => (
        <div class="group glass rounded-xl p-5 flex flex-col items-center gap-3 transition-all duration-300 hover:-translate-y-1.5 hover:border-accent/50">
          <img
            src={tech.url}
            alt={tech.name}
            loading="lazy"
            class="w-11 h-11 object-contain transition-transform duration-300 group-hover:scale-110"
          />
          <span class="text-secondary text-[13px] text-center group-hover:text-white transition-colors">
            {tech.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
