---
import ServiceCards from "./cards/ServiceCards.astro";
import { services } from "../constants/index.js";
---

<section class="relative py-24 sm:py-32" id="about">
  <span class="hash-span" id="about-anchor"></span>
  <!-- <div class="max-w-6xl mx-auto px-6 sm:px-10"> -->
  <div class="max-w-7xl mx-auto w-full px-6 sm:px-10 pt-28">
    <div class="reveal">
      <p class="text-accent uppercase tracking-[0.25em] text-sm font-medium">Introduction</p>
      <h2 class="font-display font-bold text-white text-[34px] sm:text-[52px] mt-2">Overview.</h2>

      <p class="mt-6 text-secondary text-[17px] leading-[32px] max-w-3xl">
        I'm a software developer with experience across 20+ languages and
        deep expertise in modern frameworks like React and Node.js. I adapt and
        learn quickly, working closely with clients to ship efficient, scalable,
        and user-friendly solutions to real-world problems. I've independently
        built over 180 high-quality websites for top-tier clients — and I'm
        driven by building, learning, and shared success.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal">
      {services.map((service) => (
        <ServiceCards title={service.title} image={service.icon} />
      ))}
    </div>
  </div>
</section>
