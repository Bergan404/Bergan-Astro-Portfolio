---
import Image from "astro/components/Image.astro";

interface Props {
    title: string;
    description: string;
    image: ImageMetadata;
}

const { title, image } = Astro.props;
---

<div class="group glass rounded-2xl p-8 flex flex-col items-center justify-center text-center gap-5 min-h-[220px] transition-all duration-300 hover:-translate-y-1.5 hover:border-accent/50">
    <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-accent/20 to-accent-2/10 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
        <Image src={image} alt={title} class="w-10 h-10 object-contain" />
    </div>
    <h3 class="text-white text-[19px] font-semibold">{title}</h3>
    <p class="text-secondary text-sm leading-relaxed">{Astro.props.description}</p>
</div>
