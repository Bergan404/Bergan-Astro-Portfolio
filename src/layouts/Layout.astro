---
interface Props {
	title: string;
}

const { title } = Astro.props;

import "../assets/styles/main.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Bergan Oudshoorn — Software Developer building interfaces and web applications." />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Software Developer building interfaces and web applications." />
		<meta property="og:type" content="website" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<script src="../assets/scripts/nav.js"></script>
		<script>
			// Reveal sections as they scroll into view.
			const els = document.querySelectorAll<HTMLElement>(".reveal");
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add("is-visible");
							io.unobserve(entry.target);
						}
					}
				},
				{ threshold: 0.15 }
			);
			els.forEach((el) => io.observe(el));
		</script>
	</body>
</html>
