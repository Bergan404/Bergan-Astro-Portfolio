---
import Layout from "../layouts/Layout.astro";
import Scene from "../components/canvas/Scene.vue";
import Navbar from "../components/Navbar.astro";
import Home from "../components/Home.astro";
import About from "../components/About.astro";
import Works from "../components/Works.astro";
import Tech from "../components/Tech.astro";
import Contact from "../components/Contact.astro";
---

<Layout title="Bergan Oudshoorn — Software Developer">
	<Scene client:only="vue" />

	<div class="relative z-10">
		<Navbar />
		<main>
			<Home />
			<About />
			<Works />
			<Tech />
			<Contact />
		</main>
		<footer class="relative z-10 text-center py-10 text-secondary text-sm">
			<p>© {new Date().getFullYear()} Bergan Oudshoorn.<br /> Built with Astro + Three.js.</p>
		</footer>
	</div>
</Layout>
